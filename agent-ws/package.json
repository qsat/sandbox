{
  "name": "agent-ws",
  "private": true,
  "type": "module",
  "bin": {
    "agent-ws": "./dist/agent-ws.js"
  },
  "scripts": {
    "build": "bun build src/entry/cli.ts --target=bun --outfile=dist/agent-ws.js --minify-syntax --minify-whitespace --define 'process.env.NODE_ENV=\"production\"'",
    "test": "bun test",
    "typecheck": "tsc",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && tsc && bun test",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "latest",
    "typescript": ">=5.8"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0"
  }
}
